{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Labour Market by State",
    "subtitle": "Participation rate (bar) vs unemployment rate (colour) — 2023",
    "subtitleFontStyle": "italic",
    "subtitleFontSize": 11,
    "anchor": "start"
  },
  "width": "container",
  "height": 420,
  "data": {
    "values": [
      {"state": "Johor",             "u_rate": 2.6, "p_rate": 71.3},
      {"state": "Kedah",             "u_rate": 2.9, "p_rate": 65.3},
      {"state": "Kelantan",          "u_rate": 3.5, "p_rate": 57.3},
      {"state": "Melaka",            "u_rate": 1.6, "p_rate": 70.1},
      {"state": "Negeri Sembilan",   "u_rate": 3.2, "p_rate": 66.1},
      {"state": "Pahang",            "u_rate": 2.0, "p_rate": 65.1},
      {"state": "Perak",             "u_rate": 3.9, "p_rate": 66.0},
      {"state": "Perlis",            "u_rate": 4.4, "p_rate": 61.7},
      {"state": "Pulau Pinang",      "u_rate": 2.2, "p_rate": 71.3},
      {"state": "Sabah",             "u_rate": 7.5, "p_rate": 70.1},
      {"state": "Sarawak",           "u_rate": 3.4, "p_rate": 69.0},
      {"state": "Selangor",          "u_rate": 2.7, "p_rate": 77.4},
      {"state": "Terengganu",        "u_rate": 3.4, "p_rate": 60.0},
      {"state": "W.P. Kuala Lumpur", "u_rate": 3.0, "p_rate": 74.2},
      {"state": "W.P. Labuan",       "u_rate": 6.8, "p_rate": 67.9},
      {"state": "W.P. Putrajaya",    "u_rate": 0.8, "p_rate": 78.6}
    ]
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "cornerRadiusTopRight": 3,
        "cornerRadiusBottomRight": 3
      },
      "encoding": {
        "y": {
          "field": "state",
          "type": "nominal",
          "sort": {"field": "p_rate", "order": "descending"},
          "axis": {
            "title": null,
            "labelFontSize": 11,
            "labelFont": "DM Sans"
          }
        },
        "x": {
          "field": "p_rate",
          "type": "quantitative",
          "scale": {"domain": [50, 82]},
          "axis": {
            "title": "Labour Force Participation Rate (%)",
            "titleFontSize": 11,
            "labelFontSize": 10,
            "labelFont": "DM Mono",
            "grid": true,
            "gridOpacity": 0.4
          }
        },
        "color": {
          "field": "u_rate",
          "type": "quantitative",
          "scale": {
            "domain": [0.5, 8],
            "range": ["#2a9d8f", "#c9a84c", "#e8533a"]
          },
          "legend": {
            "title": "Unemployment Rate (%)",
            "orient": "bottom",
            "gradientLength": 200,
            "titleFontSize": 10,
            "labelFontSize": 10,
            "labelFont": "DM Mono",
            "direction": "horizontal"
          }
        },
        "tooltip": [
          {"field": "state",  "type": "nominal",      "title": "State"},
          {"field": "p_rate", "type": "quantitative", "title": "Participation Rate (%)", "format": ".1f"},
          {"field": "u_rate", "type": "quantitative", "title": "Unemployment Rate (%)",  "format": ".1f"}
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 4,
        "fontSize": 10,
        "font": "DM Mono"
      },
      "encoding": {
        "y": {
          "field": "state",
          "type": "nominal",
          "sort": {"field": "p_rate", "order": "descending"}
        },
        "x": {"field": "p_rate", "type": "quantitative"},
        "text": {"field": "p_rate", "type": "quantitative", "format": ".1f"},
        "color": {"value": "#3d4f62"}
      }
    },
    {
      "mark": {
        "type": "rule",
        "strokeDash": [5, 4],
        "color": "#2d4a66",
        "opacity": 0.35,
        "strokeWidth": 1.5
      },
      "data": {"values": [{"p_rate": 68.4}]},
      "encoding": {
        "x": {"field": "p_rate", "type": "quantitative"}
      }
    },
    {
      "mark": {
        "type": "text",
        "color": "#2d4a66",
        "fontSize": 9,
        "font": "DM Mono",
        "align": "left",
        "dx": 4,
        "dy": -8
      },
      "data": {"values": [{"p_rate": 68.4}]},
      "encoding": {
        "x": {"field": "p_rate", "type": "quantitative"},
        "y": {"value": 10},
        "text": {"value": "National avg 68.4%"}
      }
    }
  ]
}