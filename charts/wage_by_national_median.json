{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Median Wage by Age Group vs Minimum Wage",
    "subtitle": "Median wage (RM) by age group, 2021–2024. Dashed lines show minimum wage threshold each year.",
    "fontSize": 16,
    "subtitleFontSize": 12,
    "anchor": "start"
  },
  "width": "container",
  "height": 420,
  "layer": [
    {
      "data": {"url": "data/wages_median_age.csv"},
      "mark": {"type": "bar", "tooltip": true},
      "encoding": {
        "x": {
          "field": "age_group",
          "type": "ordinal",
          "title": "Age group",
          "sort": ["15-19","20-24","25-29","30-34","35-39","40-44","45-49","50-54","55-59","60-64"],
          "axis": {"labelAngle": 0}
        },
        "xOffset": {
          "field": "year",
          "type": "ordinal"
        },
        "y": {
          "field": "wage",
          "type": "quantitative",
          "title": "Median wage (RM)",
          "scale": {"domainMin": 0},
          "axis": {"grid": true, "gridColor": "#e8e8e8"}
        },
        "color": {
          "field": "year",
          "type": "ordinal",
          "title": "Year",
          "scale": {
            "domain": ["2021", "2022", "2023", "2024"],
            "range": ["#B5D4F4", "#378ADD", "#185FA5", "#042C53"]
          },
          "legend": {
            "title": "Year",
            "orient": "bottom",
            "direction": "horizontal",
            "symbolType": "square",
            "symbolSize": 120,
            "titleOrient": "left"
          }
        },
        "tooltip": [
          {"field": "age_group", "type": "ordinal", "title": "Age group"},
          {"field": "year", "type": "ordinal", "title": "Year"},
          {"field": "wage", "type": "quantitative", "title": "Median wage (RM)", "format": ","}
        ]
      }
    },
    {
      "data": {"url": "wages_median_age.csv"},
      "mark": {
        "type": "text",
        "dy": -6,
        "fontSize": 8,
        "fontWeight": "bold"
      },
      "encoding": {
        "x": {
          "field": "age_group",
          "type": "ordinal",
          "sort": ["15-19","20-24","25-29","30-34","35-39","40-44","45-49","50-54","55-59","60-64"]
        },
        "xOffset": {
          "field": "year",
          "type": "ordinal"
        },
        "y": {
          "field": "wage",
          "type": "quantitative"
        },
        "text": {
          "field": "wage",
          "type": "quantitative",
          "format": ","
        },
        "color": {
          "condition": {
            "test": "datum.year == '2021' && datum.wage < 1200 || datum.year == '2022' && datum.wage < 1500 || datum.year == '2023' && datum.wage < 1500 || datum.year == '2024' && datum.wage < 1700",
            "value": "#A32D2D"
          },
          "value": "#444441"
        }
      }
    },
    {
      "data": {
        "values": [
          {"min_wage": 1200, "label": "RM 1,200 (2021)"},
          {"min_wage": 1500, "label": "RM 1,500 (2022–23)"},
          {"min_wage": 1700, "label": "RM 1,700 (2024)"}
        ]
      },
      "mark": {
        "type": "rule",
        "strokeDash": [6, 3],
        "strokeWidth": 2,
        "color": "#888780"
      },
      "encoding": {
        "y": {
          "field": "min_wage",
          "type": "quantitative"
        },
        "tooltip": [
          {"field": "label", "type": "nominal", "title": "Minimum wage"},
          {"field": "min_wage", "type": "quantitative", "title": "RM", "format": ","}
        ]
      }
    }
  ],
  "config": {
    "view": {"stroke": "transparent"},
    "bar": {"cornerRadiusEnd": 2}
  }
}