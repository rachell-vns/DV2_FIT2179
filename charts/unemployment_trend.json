{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Chart 2 — Annotated unemployment line with storytelling, zero baseline, phase bands",
  "width": "container",
  "height": 442,
  "data": { "url": "../data/lfs_month.csv" },
  "transform": [
    { "filter": "year(datum.date) >= 2021" }
  ],
  "layer": [

    {
      "data": {
        "values": [
          { "x1": "2021-01-01", "x2": "2022-04-01", "phase": "Slow recovery" },
          { "x1": "2022-04-01", "x2": "2023-06-01", "phase": "Rapid decline" },
          { "x1": "2023-06-01", "x2": "2025-06-01", "phase": "New stable range" }
        ]
      },
      "transform": [
        { "calculate": "toDate(datum.x1)", "as": "x1d" },
        { "calculate": "toDate(datum.x2)", "as": "x2d" }
      ],
      "mark": { "type": "rect", "opacity": 0.045 },
      "encoding": {
        "x":     { "field": "x1d", "type": "temporal" },
        "x2":    { "field": "x2d", "type": "temporal" },
        "y":     { "value": 0 },
        "y2":    { "value": 300 },
        "color": {
          "field": "phase",
          "type":  "nominal",
          "scale": {
            "domain": ["Slow recovery", "Rapid decline", "New stable range"],
            "range":  ["#f59e0b",       "#ef4444",       "#22c55e"]
          },
          "legend": {
            "title": "Phase",
            "orient": "top-left",
            "labelFontSize": 9,
            "titleFontSize": 9,
            "symbolSize": 60
          }
        }
      }
    },

    {
      "mark": {
        "type": "area",
        "color": "#378ADD",
        "opacity": 0.09,
        "interpolate": "monotone"
      },
      "encoding": {
        "x": { "field": "date", "type": "temporal" },
        "y": {
          "field": "u_rate",
          "type": "quantitative",
          "scale": { "zero": true }
        }
      }
    },

    {
      "mark": {
        "type": "line",
        "color": "#378ADD",
        "strokeWidth": 2.5,
        "interpolate": "monotone"
      },
      "encoding": {
        "x": {
          "field": "date",
          "type": "temporal",
          "title": null,
          "axis": {
            "format": "%b %Y",
            "labelAngle": -30,
            "tickCount": 12,
            "labelFontSize": 10,
            "labelColor": "#6b7280",
            "domainColor": "#e5e7eb",
            "grid": false
          }
        },
        "y": {
          "field": "u_rate",
          "type": "quantitative",
          "title": "Unemployment Rate (%)",
          "scale": { "zero": true },
          "axis": {
            "gridColor": "#efefef",
            "gridDash": [2, 2],
            "labelFontSize": 10,
            "labelColor": "#6b7280",
            "titleFontSize": 11,
            "tickCount": 6,
            "format": ".1f"
          }
        },
        "tooltip": [
          { "field": "date",   "type": "temporal",    "title": "Month",                "format": "%B %Y" },
          { "field": "u_rate", "type": "quantitative", "title": "Unemployment Rate (%)", "format": ".1f"  },
          { "field": "lf",     "type": "quantitative", "title": "Labour Force (000s)",   "format": ",.0f"  }
        ]
      }
    },

    {
      "mark": {
        "type": "rule",
        "color": "#9ca3af",
        "strokeDash": [5, 4],
        "strokeWidth": 1
      },
      "encoding": {
        "y": { "datum": 3.5, "type": "quantitative" }
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 6,
        "dy": -7,
        "fontSize": 9.5,
        "fontStyle": "italic",
        "color": "#9ca3af"
      },
      "encoding": {
        "x":    { "value": 0 },
        "y":    { "datum": 3.5, "type": "quantitative" },
        "text": { "value": "Pre-pandemic baseline ~3.5%" }
      }
    },

      {
  
  "data": {
    "values": [
      {
        "date": "2021-01-01",
        "y": 4.9,
        "label": "4.9% — Jan 2021",
        "note": "Pandemic tail: highest post-2020"
      },
      {
        "date": "2022-06-01",
        "y": 3.8,
        "label": "3.8% — Jun 2022",
        "note": "Borders reopen, recovery gains pace"
      }
    ]
  },
  "transform": [
    { "calculate": "toDate(datum.date)", "as": "dp" }
  ],
  "layer": [
    {
      "mark": { "type": "point", "filled": true, "size": 75, "color": "#1e40af", "opacity": 1 },
      "encoding": {
        "x": { "field": "dp", "type": "temporal" },
        "y": { "field": "y", "type": "quantitative", "scale": { "zero": true } }
      }
    },
    {
      "mark": { "type": "text", "fontSize": 10, "fontWeight": "600", "color": "#1e3a8a", "align": "left", "dx": 10, "dy": -18 },
      "encoding": {
        "x": { "field": "dp", "type": "temporal" },
        "y": { "field": "y", "type": "quantitative", "scale": { "zero": true } },
        "text": { "field": "label" }
      }
    },
    {
      "mark": { "type": "text", "fontSize": 9, "color": "#6b7280", "align": "left", "dx": 10, "dy": -4 },
      "encoding": {
        "x": { "field": "dp", "type": "temporal" },
        "y": { "field": "y", "type": "quantitative", "scale": { "zero": true } },
        "text": { "field": "note" }
      }
    }
  ]
},

{
  "data": {
    "values": [
      {
        "date": "2024-12-01",
        "y": 3.1,
        "label": "3.1% — Dec 2024",
        "note": "Near 2019 low — new normal reached"
      }
    ]
  },
  "transform": [
    { "calculate": "toDate(datum.date)", "as": "dp" }
  ],
  "layer": [
    {
      "mark": { "type": "point", "filled": true, "size": 75, "color": "#1e40af", "opacity": 1 },
      "encoding": {
        "x": { "field": "dp", "type": "temporal" },
        "y": { "field": "y", "type": "quantitative", "scale": { "zero": true } }
      }
    },
    {
      "mark": { "type": "text", "fontSize": 10, "fontWeight": "600", "color": "#1e3a8a", "align": "right", "dx": -10, "dy": -18 },
      "encoding": {
        "x": { "field": "dp", "type": "temporal" },
        "y": { "field": "y", "type": "quantitative", "scale": { "zero": true } },
        "text": { "field": "label" }
      }
    },
    {
      "mark": { "type": "text", "fontSize": 9, "color": "#6b7280", "align": "right", "dx": -10, "dy": -4 },
      "encoding": {
        "x": { "field": "dp", "type": "temporal" },
        "y": { "field": "y", "type": "quantitative", "scale": { "zero": true } },
        "text": { "field": "note" }
      }
    }
  ]
}

      
  ],
  "config": {
    "view": { "stroke": null },
    "axis": { "grid": false },
    "font": "DM Sans, sans-serif"
  }
}